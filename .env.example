# Wajib. Generate dengan: openssl rand -base64 32
AUTH_SECRET=

# Kosongkan dua baris di bawah untuk memakai akun lokal demo.
# Isi keduanya untuk login GitHub sungguhan (auto-create akun, tanpa form signup).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_URL=http://localhost:3000

# Opsional. Jumlah thread untuk whisper.cpp.
POTONG_WHISPER_THREADS=4

# Opsional. Beam/best-of whisper. Default 1 = paling cepat. Naikkan ke 5 untuk akurasi lebih tinggi.
POTONG_WHISPER_BEAM=1
POTONG_WHISPER_BEST_OF=1

# Opsional. Model transkrip. Default quantized cepat.
POTONG_WHISPER_MODEL=ggml-base-q5_1.bin

# Opsional. Batas durasi link URL dalam detik. 0 = tanpa batas (default).
POTONG_MAX_URL_SECONDS=0
